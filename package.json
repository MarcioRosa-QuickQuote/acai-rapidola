{
  "name": "acai-rapidola",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && node src/index.js",
    "dev:client": "cd client && npx vite --host",
    "build": "cd client && npx vite build",
    "start": "node server/src/index.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
